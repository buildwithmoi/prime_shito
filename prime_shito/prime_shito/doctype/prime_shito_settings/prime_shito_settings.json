  {
   "fieldname": "templates_help",
   "fieldtype": "HTML",
   "options": "<p>Jinja templates. Available: <code>{{ code }}</code> (tracking code), <code>{{ total }}</code>, <code>{{ name }}</code>, <code>{{ status }}</code>, <code>{{ url }}</code>, <code>{{ support }}</code>.</p><p><b>Write GHS, never the cedi symbol.</b> The cedi sign is not in the GSM-7 alphabet, so a single one shrinks the message from 160 characters to 70 and roughly doubles the cost of every message sent.</p>"
  },
  {
   "default": "{{ otp }} is your Prime Shito code. Valid {{ mins }} mins. Do not share it.",
