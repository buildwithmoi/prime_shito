   "label": "Order Received"
  },
  {
   "default": "Prime Shito: Order {{ code }} created. Pay GHS {{ total }} here: {{ pay_url }} Link expires in {{ mins }} mins.",
   "fieldname": "tpl_payment_pending",
   "fieldtype": "Small Text",
   "label": "Payment Pending"
  },
  {
   "default": "Prime Shito: Payment of GHS {{ paid }} received for order {{ code }}. Thank you! We will confirm your delivery soon.",
   "fieldname": "tpl_payment_confirmed",
   "fieldtype": "Small Text",
   "label": "Payment Confirmed"
  },
  {
   "default": "Prime Shito: Order {{ code }} APPROVED. Delivery to {{ zone }}. Total GHS {{ total }} ({{ pay_state }}). Help: {{ support }}",
   "fieldname": "tpl_order_approved",
