   "fieldname": "tpl_order_completed",
   "fieldtype": "Small Text",
   "label": "Order Completed"
  },
  {
   "default": "Prime Shito: Order {{ code }} was cancelled. {{ reason }} Call {{ support }} if this is a mistake.",
   "fieldname": "tpl_order_cancelled",
   "fieldtype": "Small Text",
   "label": "Order Cancelled"
  },
  {
